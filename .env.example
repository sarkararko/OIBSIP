# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MongoDB Database Connection String
MONGODB_URI="mongodb://localhost:27017/pizzacraft"

# JSON Web Token Secret for Authentication
JWT_SECRET="pizzacraft_super_secret_jwt_key_2026"

# Razorpay Sandbox Payment Gateway Credentials
RAZORPAY_KEY_ID="rzp_test_pizzacraft_sandbox"
RAZORPAY_KEY_SECRET="rzp_secret_pizzacraft_key"

# Administrator Default Credentials
ADMIN_EMAIL="admin@pizzacraft.com"
ADMIN_PASSWORD="admin123"

# Low Stock Threshold for automated alert dispatch
LOW_STOCK_THRESHOLD="20"
