# ==============================================================================
# PizzaCraft - Environment Variables Configuration Template
# Oasis Infobyte Internship - Level 3 Task
# NOTE: Do NOT commit actual secrets or credentials to source control.
# Copy this file to .env or configure in your deployment platform (Vercel/Render).
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=3000

# MongoDB Database Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/pizzacraft?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pizzacraft?retryWrites=true&w=majority

# JSON Web Token Secret for User & Admin Sessions
JWT_SECRET=your_secure_jwt_secret_key_change_in_production

# Administrator Master Authentication
ADMIN_EMAIL=admin@pizzacraft.com
ADMIN_PASSWORD=your_secure_admin_password

# Low Stock Inventory Alert Threshold
LOW_STOCK_THRESHOLD=15

# Razorpay Sandbox Credentials (Test Mode)
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Optional Live Domain URL & Cross-Origin Frontend
APP_URL=http://localhost:3000
CLIENT_URL=https://pizzacraft-frontend.vercel.app

# Frontend API Base URL (Configured in Vercel for connecting to Render backend)
# For local development, leave empty or set to http://localhost:3000
VITE_API_URL=https://pizzacraft-backend-bvqm.onrender.com

# Resend Email API Configuration (HTTP API - Not blocked on Render Free)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=
# Sender email address. Use 'onboarding@resend.dev' for initial testing, or your verified custom domain.
EMAIL_FROM=PizzaCraft <onboarding@resend.dev>
